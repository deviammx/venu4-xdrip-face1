<resources xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="https://developer.garmin.com/downloads/connect-iq/resources.xsd">

    <properties>
        <property id="BackgroundIndex" type="number">1</property>
        <property id="XdripBaseUrl" type="string">http://127.0.0.1</property>
    </properties>

    <strings>
        <string id="SettingBackgroundTitle">Background</string>
        <string id="SettingBackgroundNone">None (black)</string>
        <string id="SettingBackgroundForest">Sunset Forest</string>
        <string id="SettingBackgroundPeaks">Sunset Peaks</string>
        <string id="SettingBackgroundConfetti">Confetti Burst</string>
        <string id="SettingXdripBaseUrlTitle">xDrip+ Base URL</string>
    </strings>

    <settings>
        <setting propertyKey="@Properties.BackgroundIndex" title="@Strings.SettingBackgroundTitle">
            <settingConfig type="list">
                <listEntry value="0">@Strings.SettingBackgroundNone</listEntry>
                <listEntry value="1">@Strings.SettingBackgroundForest</listEntry>
                <listEntry value="2">@Strings.SettingBackgroundPeaks</listEntry>
                <listEntry value="3">@Strings.SettingBackgroundConfetti</listEntry>
            </settingConfig>
        </setting>

        <setting propertyKey="@Properties.XdripBaseUrl" title="@Strings.SettingXdripBaseUrlTitle">
            <settingConfig type="alphaNumeric" />
        </setting>
    </settings>
</resources>
